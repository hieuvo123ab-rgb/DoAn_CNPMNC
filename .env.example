# EDMS Environment Variables Example (Safe Placeholders)
# Copy this file to .env and replace with secure values.
# NEVER commit the real .env file.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edms_db
SPRING_DATASOURCE_USERNAME=edms_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

EDMS_JWT_SECRET=CHANGE_ME
EDMS_JWT_EXPIRATION_MS=86400000

EDMS_STORAGE_DIR=/app/storage/uploads
EDMS_KEYSTORE_PATH=/app/keys/edms-signing.p12
EDMS_KEYSTORE_PASSWORD=CHANGE_ME
EDMS_KEYSTORE_LEGACY_PASSWORD=CHANGE_ME
EDMS_KEYSTORE_ALIAS=edms-signing
SPRING_PROFILES_ACTIVE=operational-test
