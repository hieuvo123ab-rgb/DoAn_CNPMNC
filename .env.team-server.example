# Copy to .env.team-server on your Windows server (do not commit the real values).
# Recommended: run powershell -ExecutionPolicy Bypass -File scripts/setup-team-server.ps1
# These are placeholder values and MUST be replaced with independent, strong secrets.
EDMS_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_32_CHAR_SECRET
EDMS_JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_40_CHAR_OR_LONGER_SECRET
EDMS_KEYSTORE_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_16_CHAR_OR_LONGER_SECRET
EDMS_TEAM_ADMIN_USERNAME=team_admin
EDMS_TEAM_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_16_CHAR_OR_LONGER_SECRET

# Public HTTPS hostname configured as a Cloudflare Tunnel route to http://web:8080.
# Replace the example before enabling the remote profile.
EDMS_PUBLIC_ORIGIN=https://edms.example.com
# Token is secret. Leave empty for localhost-only mode.
CLOUDFLARE_TUNNEL_TOKEN=
