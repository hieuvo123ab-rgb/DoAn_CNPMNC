# Standalone EDMS Docker team server, isolated from the Railway Preview.
# Builds the same Spring Boot + React app and serves UI/API/WS at one origin.
FROM maven:3.9.6-eclipse-temurin-21 AS backend-builder
WORKDIR /build/backend
COPY backend/pom.xml ./
COPY backend/src ./src
RUN mvn --batch-mode --no-transfer-progress -DskipTests package

FROM node:20-alpine AS frontend-builder
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends \
      nginx tesseract-ocr tesseract-ocr-eng tesseract-ocr-vie \
      util-linux curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 edms \
    && useradd --uid 10001 --gid edms --home-dir /app --shell /bin/sh edms \
    && mkdir -p /app/persist /usr/share/nginx/html \
    && chown -R edms:edms /app /usr/share/nginx/html

WORKDIR /app
COPY --from=backend-builder --chown=edms:edms /build/backend/target/edms-backend-*.jar /app/app.jar
COPY --from=frontend-builder --chown=edms:edms /build/frontend/dist/ /usr/share/nginx/html/

# GitHub archives can include a 134-byte Git LFS pointer instead of the model.
# Resolve pinned model bytes and verify both length and Git LFS SHA256.
COPY --chown=edms:edms backend/models/multilingual-e5-small-onnx-int8/ /app/models/multilingual-e5-small-onnx-int8/
RUN set -eu; \
    file=/app/models/multilingual-e5-small-onnx-int8/model.onnx; \
    if grep -q '^version https://git-lfs.github.com/spec/v1' "$file"; then \
      curl --fail --location --silent --show-error --retry 4 --retry-delay 3 \
        --connect-timeout 20 --max-time 360 \
        'https://media.githubusercontent.com/media/hieuvo123ab-rgb/DoAn_CNPMNC/11596e4bb8a9b3b7e7836dc68062584d020ff160/backend/models/multilingual-e5-small-onnx-int8/model.onnx' \
        --output /tmp/edms-team-model.onnx; \
      test "$(wc -c < /tmp/edms-team-model.onnx)" -eq 118308185; \
      echo 'f80102d3f2a1229f387d3c81909990d8945513e347b0eab049f7de3c6f98c193  /tmp/edms-team-model.onnx' | sha256sum --check --status; \
      mv /tmp/edms-team-model.onnx "$file"; \
    fi; \
    test "$(wc -c < "$file")" -eq 118308185; \
    echo 'f80102d3f2a1229f387d3c81909990d8945513e347b0eab049f7de3c6f98c193  /app/models/multilingual-e5-small-onnx-int8/model.onnx' | sha256sum --check --status; \
    chown edms:edms "$file"

COPY deploy/team-preview/nginx.conf /etc/nginx/nginx.conf
COPY deploy/team-server/entrypoint.sh /app/team-server-entrypoint.sh
RUN chmod 755 /app/team-server-entrypoint.sh

ENV SPRING_PROFILES_ACTIVE=prod,team-server
EXPOSE 8080
ENTRYPOINT ["/app/team-server-entrypoint.sh"]
